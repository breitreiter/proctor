diff --git a/tests/cli.test.ts b/tests/cli.test.ts
index fddf9dd..0879888 100644
--- a/tests/cli.test.ts
+++ b/tests/cli.test.ts
@@ -60,3 +60,22 @@ test("clear on an empty list has nothing to ask", () => {
   const file = freshFile();
   assert.equal(jot(file, "clear").out, "Nothing to clear.\n");
 });
+
+test("clear --yes clears without asking", () => {
+  const file = freshFile();
+  jot(file, "add", "a");
+  jot(file, "add", "b");
+  assert.equal(jot(file, "clear", "--yes").out, "Cleared 2 tasks.\n");
+  assert.equal(jot(file, "list").out, "Nothing to do.\n");
+  jot(file, "add", "c");
+  assert.equal(jot(file, "clear", "-y").code, 0);
+});
+
+test("clear without --yes and without a terminal refuses and exits 1", () => {
+  const file = freshFile();
+  jot(file, "add", "a");
+  const r = jot(file, "clear");
+  assert.equal(r.code, 1);
+  assert.match(r.err, /--yes/);
+  assert.equal(jot(file, "list").out, "#1 [ ] a\n");
+});
