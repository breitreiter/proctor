-    public Task<string> RunAsync(Options options) =>
-        get(options.Url, TimeSpan.FromSeconds(options.TimeoutSeconds));
+    public async Task<string> RunAsync(Options options)
+    {
+        for (var attempt = 0; ; attempt++)
+        {
+            try { return await get(options.Url, TimeSpan.FromSeconds(options.TimeoutSeconds)); }
+            catch (Exception) when (attempt < options.Retry) { }
+        }
+    }
 }
