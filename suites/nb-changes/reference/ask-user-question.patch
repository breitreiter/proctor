+    // The same judge, asked through the tool instead of at the end of a turn: the question
+    // stands where the model's last message would. A hit spends one of `budget oracle_turns`,
+    // which the two routes share. Anything else is "no answer" and the run goes on: the
+    // model called a tool and is still working, so there is no halt to end as oracle_miss.
+    private async Task<AskAnswer> AnswerAskAsync(string question, CancellationToken cancellationToken)
+    {
+        var options = OracleResolver.Options(_temperatureFor?.Invoke(OracleProvider ?? Provider));
+        var reply = await _conversation.SideCallAsync(OracleResolver.BuildPrompt(_sheet!, question), options, cancellationToken, OracleClient());
+        var verdict = OracleResolver.ParseVerdict(reply, _sheet!, _warnings);
+        OracleVerdict = verdict.Raw;
+
+        if (verdict.Kind != OracleVerdictKind.Hit) return AskAnswer.Miss;
+        if (OracleTurnsUsed >= OracleTurns)
+        {
+            _warnings.Add($"oracle: {OracleTurns} resolutions spent and the model asked again — the run ended as oracle_budget");
+            return AskAnswer.Spent;
+        }
+
+        OracleTurnsUsed++;
+        return new AskAnswer(_sheet!.Compose(verdict.Keys), verdict.Keys);
+    }
+
