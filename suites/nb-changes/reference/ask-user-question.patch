diff --git a/nb.Core/AskUserTool.cs b/nb.Core/AskUserTool.cs
new file mode 100644
index 0000000..c546ef7
--- /dev/null
+++ b/nb.Core/AskUserTool.cs
@@ -0,0 +1,51 @@
+using Microsoft.Extensions.AI;
+
+namespace nb;
+
+/// <summary>What the oracle said to a question the model asked through <c>ask_user_question</c>.</summary>
+/// <param name="Text">The tool result, exactly as the model reads it.</param>
+/// <param name="Keys">The sheet entries selected; empty when nothing on the sheet answered.</param>
+/// <param name="BudgetSpent">The question had an answer but <c>budget oracle_turns</c> is spent: the run ends <c>oracle_budget</c>.</param>
+public sealed record AskAnswer(string Text, IReadOnlyList<string> Keys, bool BudgetSpent = false)
+{
+    public static AskAnswer Miss { get; } = new(AskUserTool.NoAnswer, Array.Empty<string>());
+    public static AskAnswer Spent { get; } = new(AskUserTool.BudgetSpent, Array.Empty<string>(), BudgetSpent: true);
+}
+
+/// <summary>
+/// The tool a model asks its user with. nb has no user, so the tool exists only while a
+/// program has an <c>oracle</c> attached, and the answer sheet is who answers: the same
+/// judge call that reads an end-of-turn ask reads the question
+/// (<see cref="ProgramEvaluator"/>). A tool no one can answer would be a trap, so a
+/// program without a sheet never advertises it.
+/// </summary>
+public static class AskUserTool
+{
+    public const string Name = "ask_user_question";
+
+    /// <summary>
+    /// The result when nothing on the sheet answers. The run goes on: unlike an
+    /// end-of-turn ask, the model has not stopped, so there is no halt to label.
+    /// </summary>
+    public const string NoAnswer = "The user has no answer to that question. Proceed on your own judgement.";
+
+    /// <summary>The result of the question that found <c>budget oracle_turns</c> spent. The run ends with it.</summary>
+    public const string BudgetSpent = "The user is no longer answering questions in this run.";
+
+    public static AIFunction Create()
+    {
+        var ask = (string question) => "";  // never invoked: ConversationManager routes the call to the oracle
+        return AIFunctionFactory.Create(
+            ask,
+            name: Name,
+            description: """
+                Ask the user one question and wait for the answer. Use it when you need a fact or a
+                decision only the user has, and cannot proceed sensibly without it. Ask one thing per
+                call. The result is the user's reply; if the user has no answer, it says so, and you
+                should proceed on your own judgement.
+
+                Parameters:
+                - question: the question, in a full sentence
+                """);
+    }
+}
