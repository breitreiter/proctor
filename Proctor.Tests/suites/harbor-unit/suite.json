{
  "id": "harbor-unit",
  "description": "Test data for HarborTests: one Claude Code arm, one task on ledger. Never run for real: HarborTests stand a fake uv in for Harbor.",
  "labels": {
    "area": "coding/change",
    "stack": "dotnet"
  },
  "arms": [
    {
      "id": "cc-haiku",
      "description": "Claude Code on Haiku",
      "agent": "claude-code",
      "agent_version": "2.1.301",
      "model": "claude-haiku-5-5",
      "samples": 1
    }
  ],
  "harbor": { "version": "0.24.0" },
  "limits": { "wall_ms": 900000 },
  "grading": {
    "checks": {
      "diff-in-scope": {
        "files_touched": "@expect"
      }
    },
    "pass": [
      "builds",
      "tests-pass"
    ]
  }
}
