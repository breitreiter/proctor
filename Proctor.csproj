<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>proctor</AssemblyName>
    <RootNamespace>Proctor</RootNamespace>
    <Version>0.2.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The test project and the data directories sit under this root but are not compiled into the exe. -->
  <ItemGroup>
    <Compile Remove="Proctor.Tests\**;bench\**;evals\**;suites\**;fixtures\**;runs\**;reports\**" />
    <None Remove="Proctor.Tests\**;bench\**;evals\**;suites\**;fixtures\**;runs\**;reports\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Proctor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.0" />
  </ItemGroup>

</Project>
