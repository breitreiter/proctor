{
  "//": "nb's config for every eval here. Mock entries drive the smoke eval; imp-qcoder is the floor arm of code-change.",
  "//2": "MINROUTER_KEY is the minrouter key on imp; export it before `proctor run code-change`.",
  "Harness": "nb",
  "ActiveProvider": "Mock",
  "Trust": false,
  "ChatProviders": [
    { "Name": "Mock", "Response": "OK" },
    { "Name": "MockB", "Provider": "Mock", "Response": "OK, from B" },
    {
      "Name": "imp-qcoder",
      "Provider": "LocalLlm",
      "Harness": "nb",
      "Endpoint": "http://imp:8086/x/imp-qcoder/v1",
      "ApiKey": "${MINROUTER_KEY}",
      "Model": "qcoder",
      "MaxContextTokens": 131072,
      "Temperature": 0.2
    }
  ]
}
