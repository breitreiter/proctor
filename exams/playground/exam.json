{
  "id": "playground",
  "description": "The first exam to run: two scripted tasks against a tiny TypeScript CLI, no model and no key, so the loop and the report can be seen before anything real is measured.",
  "attempts": 2,
  "labels": { "purpose": "onboarding" },
  "grading": {
    "checks": {
      "exit_ok":      { "exit_reason": "ok" },
      "no_denials":   { "denied_calls": { "max": 0 } },
      "under_budget": { "max_tool_calls": 3, "max_tokens": 100000 },
      "says":         { "answer_contains": "@expect" }
    },
    "correctness": ["exit_ok", "says", "builds", "tests-pass"]
  }
}
