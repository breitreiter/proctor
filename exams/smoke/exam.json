{
  "id": "smoke",
  "description": "Proctor's own shakedown: three scripted tasks against nb's Mock provider, so the pipeline and the report can be tested without a model.",
  "attempts": 2,
  "hooks": {
    "variant":    { "setup": "hooks/variant-setup.sh" },
    "attempt": { "setup": "hooks/attempt-setup.sh", "teardown": "hooks/attempt-teardown.sh" }
  },
  "grading": {
    "checks": {
      "exit_ok":       { "exit_reason": "ok" },
      "no_denials":    { "denied_calls": { "max": 0 } },
      "not_nudged":    { "loop_nudged": false },
      "under_budget":  { "max_tool_calls": 3, "max_tokens": 100000 },
      "says-expected": { "answer_contains": "@expect" },
      "touches-note":  { "files_touched": { "paths": ["note.txt"], "mode": "at_least" } },
      "answer-nonempty": { "script": "checks/answer-nonempty.sh", "description": "the last assistant message is not empty" }
    },
    "correctness": ["exit_ok", "says-expected"]
  }
}
