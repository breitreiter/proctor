# Raw run tier: transcripts, stderr, config snapshots (may carry API keys).
# Archived to object storage via `proctor archive`; see project/learnings/where-runs-live.md
runs/
**/runs/

# .NET
bin/
obj/
*.user
.idea/
.vs/

# Local config with keys
appsettings.json
!appsettings.example.json
suites/proctor.json
suites/nb.json
# A second machine's config, such as suites/proctor.modal.json
suites/proctor.*.json
suites/nb.*.json
!suites/*.example.json
suites/codex.toml

# Fixture checkouts made by sample setup hooks
.proctor/

# Reports are derived data written by `proctor report`; the smoke eval's are not worth committing
/reports/

# Snapshot tests: the received rendering awaiting review (see Proctor.Tests/ReportTests.cs)
*.received

# bench experiments, raw tier
bench/systemone/root/runs/

# Python
__pycache__/
